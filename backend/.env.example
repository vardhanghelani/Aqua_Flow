PORT=5000
MONGODB_URI=mongodb://localhost:27017/aqua_flow
JWT_SECRET=replace-with-32-plus-char-random-string-required-at-startup
JWT_EXPIRES_IN=24h
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Production: no trailing slash — https://aqua-flow-pi.vercel.app
# First deploy on Render (no Shell on free tier): set to true, redeploy, then remove
# SEED_IF_EMPTY=true
# Wipe entire DB and reload sample data on next deploy (remove after one deploy!)
# SEED_RESET=true
